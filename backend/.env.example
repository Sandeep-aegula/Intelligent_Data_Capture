# ProjectPulse AI Backend Configuration
# Copy this file to .env and adjust variables as needed for your environment.

# Database URL
# PostgreSQL (Production / Standard):
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/projectpulse_db
# SQLite Fallback (Automated development without PostgreSQL service):
# DATABASE_URL=sqlite:///./projectpulse.db

# Application
PROJECT_NAME="ProjectPulse AI"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT=development

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# AI / Semantic Matching (Optional)
# If left empty, deterministic and RapidFuzz token matching are used
SENTENCE_TRANSFORMERS_MODEL=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_PROVIDER="mock"

# Schedule Matching Thresholds
HIGH_CONFIDENCE_THRESHOLD=85.0
LOW_CONFIDENCE_THRESHOLD=60.0
